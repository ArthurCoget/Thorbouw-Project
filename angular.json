{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "thorbouw-project": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "i18n": {
        "sourceLocale": { "code": "nl-BE", "subPath": "nl" },
        "locales": {
          "fr-BE": { "translation": "src/locale/messages.fr.xlf", "subPath": "fr" },
          "en-US": { "translation": "src/locale/messages.en.xlf", "subPath": "en" }
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "localize": true,
            "i18nMissingTranslation": "warning",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.css", "node_modules/maplibre-gl/dist/maplibre-gl.css"],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "ssr": {
              "entry": "src/server.ts"
            },
            "polyfills": ["@angular/localize/init"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "security": {
                "allowedHosts": ["localhost"]
              },
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "fr": {
              "localize": ["fr-BE"]
            },
            "en": {
              "localize": ["en-US"]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "thorbouw-project:build:production"
            },
            "development": {
              "buildTarget": "thorbouw-project:build:development",
              "allowedHosts": ["localhost", "192.168.1.25", "0.0.0.0"]
            },
            "fr": { "buildTarget": "thorbouw-project:build:development,fr" },
            "en": { "buildTarget": "thorbouw-project:build:development,en" }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "ng-extract-i18n-merge:ng-extract-i18n-merge",
          "options": {
            "buildTarget": "thorbouw-project:build",
            "format": "xlf",
            "outputPath": "src/locale",
            "targetFiles": ["messages.fr.xlf", "messages.en.xlf"]
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.css"],
            "polyfills": ["@angular/localize/init"]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
